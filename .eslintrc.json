{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": "error",
    "no-duplicate-imports": "error",
    "prefer-const": "warn"
  },
  "ignorePatterns": ["node_modules/", "data/", "frontend/dist/", "config.local.json", "config.json"]
}
