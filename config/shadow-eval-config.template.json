{
  "server": {
    "host": "127.0.0.1",
    "port": 28788,
    "data_dir": "./data",
    "request_timeout_ms": 90000,
    "max_request_body_bytes": 10485760
  },
  "intelligence": {
    "mode": "shadow",
    "shadow": {
      "policy": { "tierPreference": true, "preferFree": true },
      "retentionDays": 30
    }
  },
  "routing": {
    "strategy": "tier_weighted",
    "tier_weights": { "tier1": 10, "tier2": 5, "tier3": 1 },
    "max_concurrent": 16,
    "max_retries": 3,
    "retry_backoff_ms": 500,
    "cooldown_default_sec": 60,
    "health_check_interval_sec": 300,
    "failover_on_error": true
  },
  "models": [
    {
      "id": "example-model-free",
      "provider": "example-provider",
      "apiModel": "example-model-free",
      "tier": "tier1",
      "paid": false,
      "capability": ["chat", "tool_use", "streaming"],
      "max_tokens": 64000,
      "context_window": 128000,
      "price": { "input_cost_per_1k": 0, "output_cost_per_1k": 0, "currency": "USD" },
      "enabled": true
    },
    {
      "id": "example-model-vision",
      "provider": "example-provider",
      "apiModel": "example-model-vision",
      "tier": "tier2",
      "paid": true,
      "capability": ["chat", "vision"],
      "max_tokens": 16000,
      "context_window": 32000,
      "price": { "input_cost_per_1k": 0.005, "output_cost_per_1k": 0.01, "currency": "USD" },
      "enabled": true
    }
  ],
  "providers": [
    {
      "name": "example-provider",
      "base_url": "https://EXAMPLE-BASE-URL/v1",
      "api_key": "REPLACE_WITH_REAL_KEY",
      "auth_header": "Authorization",
      "auth_prefix": "Bearer "
    }
  ],
  "agent_bindings": {},
  "budget": {
    "allowPaid": false,
    "maxRequestCost": 10,
    "allowedModels": [],
    "allowedProviders": [],
    "strictModel": false
  },
  "circuit_breaker": {
    "enabled": true,
    "failure_threshold": 10,
    "failure_window_sec": 60,
    "open_state_sec": 120,
    "half_open_max_calls": 2,
    "key_disable_on_auth_invalid": true
  }
}
