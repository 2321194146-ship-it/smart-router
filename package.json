{
  "name": "smart-router",
  "version": "6.1.0",
  "description": "AI Gateway with intelligent model routing, circuit breaker, semantic cache, rate limiting, and real-time dashboard",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "smart-router": "./src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "eslint src/*.js test/*.js",
    "syntax:check": "for f in src/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0"
  },
  "keywords": [
    "ai-gateway",
    "llm-router",
    "model-router",
    "openai-proxy",
    "circuit-breaker",
    "rate-limiting",
    "semantic-cache"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/smart-router"
  }
}
