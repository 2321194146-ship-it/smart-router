{
  "name": "smart-router-mainline",
  "version": "1.0.0-phase2c-active-canary",
  "description": "Smart Router Mainline - Phase 2-A Shadow (intelligence.mode=off|shadow)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js test/audit/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:audit": "node --test test/audit/*.test.js",
    "test:all": "node --test test/unit/*.test.js test/integration/*.test.js test/audit/*.test.js",
    "syntax:check": "node --check src/index.js && node --check src/server.js"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
